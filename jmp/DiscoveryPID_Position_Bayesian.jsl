// DiscoveryPID_Position_Bayesian.jsl
// Automatic JMP Bayesian optimization for position return-to-home PID.
//
// The firmware performs a repeatable test:
//   1. Conservative fixed gains move the stick to testOffsetDeg.
//   2. The candidate Kp/Ki/Kd is activated.
//   3. Target changes to Home = 0.
//   4. Python scores settling time, overshoot, oscillations, IAE, and final error.
//   5. JMP chooses the next Kp/Ki/Kd.
//
// Before running:
//   - Upload the position-hold firmware.
//   - Open the serial monitor once.
//   - Move the stick left/right, hold it upright, and wait for EVENT HOMED.
//   - Close the serial monitor so COM7 is free.
//   - Run this script and click Arm and Start once.

Names Default To Here( 1 );

// ============================================================================
// USER SETTINGS
// ============================================================================

studyName = "PositionStudy_001";

portName = "COM7";
testOffsetDeg = 20.0;

maxTotalRuns = 30;
requireStartupConfirmation = 1;
supervisedMode = 0;

// Position PID search ranges.
kpLow = 0.10;
kpHigh = 2.00;

kiLow = 0.00;
kiHigh = 0.40;

kdLow = 0.00;
kdHigh = 0.08;

// ============================================================================
// PATHS
// ============================================================================

projectDirectory =
    "C:/Users/mkime/Documents/GITHUB/PID Discovery/DiscoveryPID/";

pythonExecutable =
    "C:/Users/mkime/.platformio/penv/Scripts/python.exe";

workerScript =
    projectDirectory || "tools/run_position_trial.py";

workingTablePath =
    projectDirectory ||
    "data/position_autotune/" ||
    studyName ||
    "_Optimization.jmp";

compactCSVPath =
    projectDirectory ||
    "data/position_autotune/" ||
    studyName ||
    "_Optimization.csv";

historyCSVPath =
    projectDirectory ||
    "data/position_autotune/" ||
    studyName ||
    "_Response_History.csv";

resultDirectory =
    projectDirectory ||
    "data/position_autotune/results/" ||
    studyName ||
    "/";

runDirectory =
    projectDirectory ||
    "data/position_autotune/runs/" ||
    studyName ||
    "/";

cmdExecutable =
    Get Environment Variable( "ComSpec" );

tempDirectory =
    Get Environment Variable( "TEMP" ) || "/";

// ============================================================================
// SAFE INITIAL DESIGN
// ============================================================================

seedSettings = {
    {0.40, 0.00, 0.000},
    {0.80, 0.00, 0.020},
    {1.20, 0.00, 0.040},
    {0.60, 0.10, 0.020},
    {1.20, 0.20, 0.040},
    {1.80, 0.10, 0.070},
    {0.25, 0.30, 0.010}
};

maximumBayesianRuns =
    Max(
        0,
        maxTotalRuns - N Items( seedSettings )
    );

// ============================================================================
// HELPERS
// ============================================================================

quoteArgument = Function( {value},
    "\!\"" || Char( value ) || "\!\""
);

showFatalError = Function( {messageText},
    New Window(
        "DiscoveryPID Position Study Error",
        <<Modal,
        V List Box(
            Text Box( messageText ),
            Button Box(
                "OK",
                Current Window() << Close Window
            )
        )
    );

    Throw( messageText );
);

validateSetup = Function( {},
    If(
        Is Missing( cmdExecutable ) |
        Length( Char( cmdExecutable ) ) == 0,

        showFatalError(
            "Windows command processor was not found."
        )
    );

    If(
        !File Exists( pythonExecutable ),

        showFatalError(
            "Python executable was not found:\!N\!N" ||
            pythonExecutable
        )
    );

    If(
        !File Exists( workerScript ),

        showFatalError(
            "Position trial worker was not found:\!N\!N" ||
            workerScript
        )
    );

    If(
        maxTotalRuns < N Items( seedSettings ),

        showFatalError(
            "maxTotalRuns must be at least " ||
            Char( N Items( seedSettings ) ) ||
            "."
        )
    );
);

confirmStudyStart = Function( {},
    {choice = 0},

    If(
        !requireStartupConfirmation,
        Return( 1 )
    );

    New Window(
        "Arm Position PID Study",
        <<Modal,

        V List Box(
            Text Box(
                "Study: " ||
                studyName ||
                "\!N\!N" ||

                "Test displacement: " ||
                Char( testOffsetDeg ) ||
                " degrees\!N" ||

                "Maximum total runs: " ||
                Char( maxTotalRuns ) ||
                "\!N\!N" ||

                "Confirm EVENT HOMED was displayed after manually " ||
                "centering the stick.\!N" ||

                "Close all serial monitors using " ||
                portName ||
                ".\!N" ||

                "After arming, trials run automatically."
            ),

            H List Box(
                Button Box(
                    "Arm and Start",
                    choice = 1;
                    Current Window() << Close Window;
                ),

                Button Box(
                    "Cancel",
                    choice = 0;
                    Current Window() << Close Window;
                )
            )
        )
    );

    choice;
);

ensureWorkingTable = Function( {},
    {dt, kpLimits, kiLimits, kdLimits},

    If(
        File Exists( workingTablePath ),

        dt = Open( workingTablePath ),

        dt = New Table(
            studyName || " Position PID Optimization",

            New Column(
                "Run",
                Numeric,
                Ordinal,
                Format( "Best", 12 )
            ),

            New Column(
                "Iteration",
                Numeric,
                Ordinal,
                Format( "Best", 12 )
            ),

            New Column(
                "KP",
                Numeric,
                Continuous,
                Format( "Fixed Dec", 12, 6 )
            ),

            New Column(
                "KI",
                Numeric,
                Continuous,
                Format( "Fixed Dec", 12, 6 )
            ),

            New Column(
                "KD",
                Numeric,
                Continuous,
                Format( "Fixed Dec", 12, 6 )
            ),

            New Column(
                "Score",
                Numeric,
                Continuous,
                Format( "Fixed Dec", 12, 6 ),

                Set Property(
                    "Response Limits",
                    {
                        Goal( Minimize ),
                        Importance( 1 ),
                        Show Limits( 0 )
                    }
                )
            ),

            New Column(
                "Settling Time (s)",
                Numeric,
                Continuous,
                Format( "Fixed Dec", 12, 5 )
            ),

            New Column(
                "Overshoot (deg)",
                Numeric,
                Continuous,
                Format( "Fixed Dec", 12, 5 )
            ),

            New Column(
                "Oscillations",
                Numeric,
                Ordinal,
                Format( "Best", 12 )
            ),

            New Column(
                "IAE (deg*s)",
                Numeric,
                Continuous,
                Format( "Fixed Dec", 12, 5 )
            ),

            New Column(
                "Peak Output RPM",
                Numeric,
                Continuous,
                Format( "Fixed Dec", 12, 5 )
            ),

            New Column(
                "Final Error (deg)",
                Numeric,
                Continuous,
                Format( "Fixed Dec", 12, 5 )
            ),

            New Column(
                "Success",
                Numeric,
                Nominal,
                Format( "Best", 12 )
            ),

            New Column(
                "Status",
                Character,
                Nominal
            )
        );

        dt << Save( workingTablePath );
    );

    kpLimits = Eval List( {kpLow, kpHigh} );
    kiLimits = Eval List( {kiLow, kiHigh} );
    kdLimits = Eval List( {kdLow, kdHigh} );

    Eval(
        Eval Expr(
            Column( dt, "KP" ) <<
            Set Property( "Coding", Expr( kpLimits ) )
        )
    );

    Eval(
        Eval Expr(
            Column( dt, "KI" ) <<
            Set Property( "Coding", Expr( kiLimits ) )
        )
    );

    Eval(
        Eval Expr(
            Column( dt, "KD" ) <<
            Set Property( "Coding", Expr( kdLimits ) )
        )
    );

    For Each(
        {columnName},
        {"KP", "KI", "KD"},

        Column( dt, columnName ) <<
            Set Property(
                "Design Role",
                DesignRole( Continuous )
            );

        Column( dt, columnName ) <<
            Set Property(
                "Factor Changes",
                Easy
            );
    );

    Column( dt, "Score" ) <<
        Set Property(
            "Response Limits",
            {
                Goal( Minimize ),
                Importance( 1 ),
                Show Limits( 0 )
            }
        );

    dt;
);

exportCompactTable = Function( {dt},
    {
        text =
            "Run,Iteration,KP,KI,KD,Score,Settling Time (s)," ||
            "Overshoot (deg),Oscillations,IAE (deg*s),Peak Output RPM," ||
            "Final Error (deg),Success,Status\!N",

        rowIndex,
        scoreValue
    },

    For(
        rowIndex = 1,
        rowIndex <= N Rows( dt ),
        rowIndex++,

        scoreValue =
            Column( dt, "Score" )[rowIndex];

        If(
            !Is Missing( scoreValue ),

            text ||=
                Char( Column( dt, "Run" )[rowIndex] ) || "," ||
                Char( Column( dt, "Iteration" )[rowIndex] ) || "," ||
                Char( Column( dt, "KP" )[rowIndex] ) || "," ||
                Char( Column( dt, "KI" )[rowIndex] ) || "," ||
                Char( Column( dt, "KD" )[rowIndex] ) || "," ||
                Char( scoreValue ) || "," ||
                Char( Column( dt, "Settling Time (s)" )[rowIndex] ) || "," ||
                Char( Column( dt, "Overshoot (deg)" )[rowIndex] ) || "," ||
                Char( Column( dt, "Oscillations" )[rowIndex] ) || "," ||
                Char( Column( dt, "IAE (deg*s)" )[rowIndex] ) || "," ||
                Char( Column( dt, "Peak Output RPM" )[rowIndex] ) || "," ||
                Char( Column( dt, "Final Error (deg)" )[rowIndex] ) || "," ||
                Char( Column( dt, "Success" )[rowIndex] ) || "," ||
                Column( dt, "Status" )[rowIndex] ||
                "\!N";
        );
    );

    Save Text File(
        compactCSVPath,
        text,
        Mode( "Replace" )
    );
);

combinationAlreadyCompleted =
Function( {dt, kpValue, kiValue, kdValue},
    {matchingRows},

    matchingRows =
        dt << Get Rows Where(
            Abs( :KP - kpValue ) < 0.000001 &
            Abs( :KI - kiValue ) < 0.000001 &
            Abs( :KD - kdValue ) < 0.000001 &
            !Is Missing( :Score )
        );

    N Rows( matchingRows ) > 0;
);

nextRunNumber = Function( {dt},
    If(
        N Rows( dt ) == 0,
        1,
        Max( Column( dt, "Run" ) << Get Values ) + 1
    );
);

successfulRunExists = Function( {dt},
    If(
        N Rows( dt ) == 0,
        0,
        Sum(
            Column( dt, "Success" ) << Get Values
        ) > 0
    );
);

bestScore = Function( {dt},
    {values, completedRows},

    values =
        Column( dt, "Score" ) << Get Values;

    completedRows =
        Loc( !Is Missing( values ) );

    If(
        N Rows( completedRows ) == 0,
        .,
        Min( values[completedRows] )
    );
);

confirmPhysicalRun =
Function(
    {
        runNumber,
        kpValue,
        kiValue,
        kdValue,
        phaseName
    },

    {choice = 0},

    If(
        !supervisedMode,
        Return( 1 )
    );

    New Window(
        "Position Trial Confirmation",
        <<Modal,

        V List Box(
            Text Box(
                phaseName ||
                " run " ||
                Char( runNumber ) ||
                "\!N\!N" ||

                "KP = " || Char( kpValue ) || "\!N" ||
                "KI = " || Char( kiValue ) || "\!N" ||
                "KD = " || Char( kdValue ) || "\!N"
            ),

            H List Box(
                Button Box(
                    "Run Trial",
                    choice = 1;
                    Current Window() << Close Window;
                ),

                Button Box(
                    "Stop Study",
                    choice = 0;
                    Current Window() << Close Window;
                )
            )
        )
    );

    choice;
);

runPhysicalTrial =
Function( {runNumber, kpValue, kiValue, kdValue},
    {
        resultPath,
        rawPath,
        batchPath,
        consoleLogPath,
        batchText,
        outputText,
        displayedOutput,
        resultDT,
        resultList
    },

    resultPath =
        resultDirectory ||
        "Run_" ||
        Char( runNumber ) ||
        "_result.csv";

    rawPath =
        runDirectory ||
        "Run_" ||
        Char( runNumber ) ||
        "_response.csv";

    batchPath =
        tempDirectory ||
        "DiscoveryPID_" ||
        studyName ||
        "_Run_" ||
        Char( runNumber ) ||
        ".bat";

    consoleLogPath =
        tempDirectory ||
        "DiscoveryPID_" ||
        studyName ||
        "_Run_" ||
        Char( runNumber ) ||
        "_console.txt";

    If( File Exists( resultPath ), Delete File( resultPath ) );
    If( File Exists( batchPath ), Delete File( batchPath ) );
    If( File Exists( consoleLogPath ), Delete File( consoleLogPath ) );

    batchText =
        "@echo off\!N" ||

        quoteArgument( pythonExecutable ) || " " ||
        quoteArgument( workerScript ) || " " ||

        "--port " || quoteArgument( portName ) || " " ||
        "--trial " || Char( runNumber ) || " " ||

        "--kp " || Char( kpValue ) || " " ||
        "--ki " || Char( kiValue ) || " " ||
        "--kd " || Char( kdValue ) || " " ||

        "--test-offset " || Char( testOffsetDeg ) || " " ||

        "--result-file " || quoteArgument( resultPath ) || " " ||
        "--raw-file " || quoteArgument( rawPath ) || " " ||
        "--history-file " || quoteArgument( historyCSVPath ) ||

        "\!N" ||
        "exit /b %ERRORLEVEL%\!N";

    Save Text File(
        batchPath,
        batchText,
        Mode( "Replace" )
    );

    outputText =
        Run Program(
            Executable( cmdExecutable ),

            Options(
                {
                    "/d",
                    "/c",
                    quoteArgument( batchPath )
                }
            ),

            Read Function( "text" )
        );

    displayedOutput =
        If(
            Is Missing( outputText ),
            "(No console output returned.)",
            Char( outputText )
        );

    Save Text File(
        consoleLogPath,
        displayedOutput,
        Mode( "Replace" )
    );

    Print( displayedOutput );

    If(
        !File Exists( resultPath ),

        New Window(
            "Position Trial Failed",
            <<Modal,

            V List Box(
                Text Box(
                    "Python did not create a result file.\!N\!N" ||
                    "Console log:\!N" ||
                    consoleLogPath ||
                    "\!N\!N" ||
                    displayedOutput
                ),

                Button Box(
                    "OK",
                    Current Window() << Close Window
                )
            )
        );

        Return( {} );
    );

    resultDT = Open( resultPath, Invisible );

    resultList = Eval List(
        {
            Column( resultDT, "Score" )[1],
            Column( resultDT, "Settling Time (s)" )[1],
            Column( resultDT, "Overshoot (deg)" )[1],
            Column( resultDT, "Oscillations" )[1],
            Column( resultDT, "IAE (deg*s)" )[1],
            Column( resultDT, "Peak Output RPM" )[1],
            Column( resultDT, "Final Error (deg)" )[1],
            Column( resultDT, "Success" )[1],
            Column( resultDT, "Status" )[1]
        }
    );

    Close( resultDT, No Save );

    resultList;
);

saveCompletedRun =
Function(
    {
        dt,
        rowIndex,
        runNumber,
        iterationNumber,
        resultList
    },

    Column( dt, "Run" )[rowIndex] = runNumber;
    Column( dt, "Iteration" )[rowIndex] = iterationNumber;

    Column( dt, "Score" )[rowIndex] = resultList[1];
    Column( dt, "Settling Time (s)" )[rowIndex] = resultList[2];
    Column( dt, "Overshoot (deg)" )[rowIndex] = resultList[3];
    Column( dt, "Oscillations" )[rowIndex] = resultList[4];
    Column( dt, "IAE (deg*s)" )[rowIndex] = resultList[5];
    Column( dt, "Peak Output RPM" )[rowIndex] = resultList[6];
    Column( dt, "Final Error (deg)" )[rowIndex] = resultList[7];
    Column( dt, "Success" )[rowIndex] = resultList[8];
    Column( dt, "Status" )[rowIndex] = resultList[9];

    dt << Save( workingTablePath );
    exportCompactTable( dt );
);

// ============================================================================
// STARTUP
// ============================================================================

validateSetup();

If(
    !confirmStudyStart(),
    Throw( "Position study cancelled." )
);

dt = ensureWorkingTable();
Current Data Table( dt );

stopRequested = 0;
stopReason = "";

If(
    successfulRunExists( dt ),
    stopRequested = 1;
    stopReason =
        "This study already contains a successful PID combination.";
);

// ============================================================================
// SEEDS
// ============================================================================

If(
    !stopRequested,

    For(
        seedIndex = 1,
        seedIndex <= N Items( seedSettings ),
        seedIndex++,

        seedKp = seedSettings[seedIndex][1];
        seedKi = seedSettings[seedIndex][2];
        seedKd = seedSettings[seedIndex][3];

        If(
            N Rows( dt ) >= maxTotalRuns,
            stopRequested = 1;
            stopReason = "Maximum total run count reached.";
            Break();
        );

        If(
            !combinationAlreadyCompleted(
                dt,
                seedKp,
                seedKi,
                seedKd
            ),

            runNumber = nextRunNumber( dt );

            If(
                !confirmPhysicalRun(
                    runNumber,
                    seedKp,
                    seedKi,
                    seedKd,
                    "Seed"
                ),

                stopRequested = 1;
                stopReason = "Study stopped by operator.";
                Break();
            );

            resultList =
                runPhysicalTrial(
                    runNumber,
                    seedKp,
                    seedKi,
                    seedKd
                );

            If(
                N Items( resultList ) == 0,

                stopRequested = 1;
                stopReason = "Physical trial failed.";
                Break();
            );

            dt << Add Rows( 1 );
            newRow = N Rows( dt );

            Column( dt, "KP" )[newRow] = seedKp;
            Column( dt, "KI" )[newRow] = seedKi;
            Column( dt, "KD" )[newRow] = seedKd;

            saveCompletedRun(
                dt,
                newRow,
                runNumber,
                0,
                resultList
            );

            If(
                resultList[8] == 1,

                stopRequested = 1;
                stopReason =
                    "Position response target achieved during seed run " ||
                    Char( runNumber ) ||
                    ".";
                Break();
            );
        );
    );
);

// ============================================================================
// BAYESIAN OPTIMIZATION
// ============================================================================

If(
    !stopRequested,

    For(
        bayesIteration = 1,
        bayesIteration <= maximumBayesianRuns,
        bayesIteration++,

        If(
            N Rows( dt ) >= maxTotalRuns,
            stopRequested = 1;
            stopReason = "Maximum total run count reached.";
            Break();
        );

        runNumber = nextRunNumber( dt );
        rowsBefore = N Rows( dt );

        bo =
            dt << Bayesian Optimization(
                Y( :Score ),

                X(
                    :KP,
                    :KI,
                    :KD
                ),

                Iteration( :Iteration ),
                Run Order( :Run ),

                Generate Candidate Set(
                    Candidate Set Size( 4000 ),
                    Include Runs that Do Not Conform to Constraints( 0 )
                ),

                Autoselect Batch(
                    Batch Size( 1 ),
                    Minimum RSquare( 0.50 )
                ),

                Make Table Options(
                    Location( 1 ),
                    Randomize Runs( 0 ),
                    Save desirability function values to columns( 0 ),
                    Save startup script for next batch selection to data table( 0 ),
                    Include observed desirabilities( 0 ),
                    Include original candidate set row indices( 0 ),
                    Include reason added column( 0 ),
                    Include predicted response values( 0 ),
                    Include prediction standard deviations( 0 ),
                    Include Bayesian desirability expected improvement column( 0 )
                )
            );

        bo << Make Table;
        Wait( 0.2 );
        Report( bo ) << Close Window;

        If(
            N Rows( dt ) <= rowsBefore,

            stopRequested = 1;
            stopReason =
                "JMP Bayesian Optimization did not append a candidate row.";
            Break();
        );

        newRow = N Rows( dt );

        proposedKp = Column( dt, "KP" )[newRow];
        proposedKi = Column( dt, "KI" )[newRow];
        proposedKd = Column( dt, "KD" )[newRow];

        If(
            !confirmPhysicalRun(
                runNumber,
                proposedKp,
                proposedKi,
                proposedKd,
                "Bayesian"
            ),

            dt << Delete Rows( newRow );
            dt << Save( workingTablePath );

            stopRequested = 1;
            stopReason = "Study stopped by operator.";
            Break();
        );

        resultList =
            runPhysicalTrial(
                runNumber,
                proposedKp,
                proposedKi,
                proposedKd
            );

        If(
            N Items( resultList ) == 0,

            dt << Delete Rows( newRow );
            dt << Save( workingTablePath );

            stopRequested = 1;
            stopReason = "Physical trial failed.";
            Break();
        );

        saveCompletedRun(
            dt,
            newRow,
            runNumber,
            bayesIteration,
            resultList
        );

        If(
            resultList[8] == 1,

            stopRequested = 1;
            stopReason =
                "Position response target achieved during Bayesian run " ||
                Char( runNumber ) ||
                ".";
            Break();
        );
    );
);

If(
    stopReason == "",

    If(
        N Rows( dt ) >= maxTotalRuns,
        stopReason = "Maximum total run count reached.",
        stopReason = "Configured Bayesian run limit reached."
    );
);

// ============================================================================
// REPORTS
// ============================================================================

exportCompactTable( dt );
dt << Save( workingTablePath );
dt << Bring Window To Front;

If(
    N Rows( dt ) > 0,

    dt << Graph Builder(
        Size( 720, 450 ),
        Show Control Panel( 0 ),

        Variables(
            X( :Run ),
            Y( :Score )
        ),

        Elements(
            Points( X, Y, Legend( 3 ) ),
            Line( X, Y, Legend( 5 ) )
        ),

        SendToReport(
            Dispatch(
                {},
                "graph title",
                TextEditBox,
                {
                    Set Text(
                        studyName ||
                        " — Position PID Score by Run"
                    )
                }
            )
        )
    );
);

If(
    File Exists( historyCSVPath ),

    historyDT = Open( historyCSVPath );

    historyDT << Graph Builder(
        Size( 850, 500 ),
        Show Control Panel( 0 ),

        Variables(
            X( :"Return Time (s)"n ),
            Y( :"Position (deg)"n ),
            Overlay( :Run )
        ),

        Elements(
            Line( X, Y, Legend( 6 ) )
        ),

        SendToReport(
            Dispatch(
                {},
                "graph title",
                TextEditBox,
                {
                    Set Text(
                        studyName ||
                        " — Return-to-Home Position by Run"
                    )
                }
            )
        )
    );
);

currentBest = bestScore( dt );

New Window(
    "DiscoveryPID Position Study Complete",
    <<Modal,

    V List Box(
        Text Box(
            "Study: " || studyName || "\!N\!N" ||

            "Stop reason:\!N" ||
            stopReason ||
            "\!N\!N" ||

            "Completed runs: " ||
            Char( N Rows( dt ) ) ||
            " of " ||
            Char( maxTotalRuns ) ||
            "\!N" ||

            "Best score: " ||
            If(
                Is Missing( currentBest ),
                "N/A",
                Char( currentBest )
            ) ||
            "\!N\!N" ||

            "Optimization table:\!N" ||
            workingTablePath ||
            "\!N\!N" ||

            "Compact results:\!N" ||
            compactCSVPath ||
            "\!N\!N" ||

            "Response history:\!N" ||
            historyCSVPath
        ),

        Button Box(
            "OK",
            Current Window() << Close Window
        )
    )
);
