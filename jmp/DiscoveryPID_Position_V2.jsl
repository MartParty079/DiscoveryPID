// Tune positional PID gains using measured settling time and overshoot.
Names Default To Here(1);
start = hptime();
// --- Connection and trial settings ---
// Update these paths and the serial port for the local machine.
port = "COM3";
root = "C:\Users\vgolf\Documents\DiscoveryPID\DiscoveryPID";
python = "C:\Users\vgolf\.platformio\penv\Scripts\python.exe";
worker = root || "\tools\run_position_trial.py";

// Initial gain combinations, in {KP, KI, KD} order.
seeds = {
    {1.844, 2.008, .230},
    {1.650, 1.700, .100},
    {2.050, 2.300, .400},
    {2.560, .217, 2.610}
};
maxRuns = 27; // About 100 minutes at full setup/return/recovery limits; includes seeds and failures.

// --- Python trial bridge ---
// Wrap an argument in double quotes to preserve paths containing spaces.
q = Function({x}, "\!"" || Char(x) || "\!"");

// Create one unique experiment folder for all seed and optimization trials.
experimentDir = Trim(Run Program(
    Executable(python),
    Options({q(worker), "--new-experiment"}),
    Read Function("text")
));
If(!Directory Exists(experimentDir),
    Throw("Could not create the experiment log folder: " || experimentDir)
);
Show(experimentDir);

// Run one hardware trial and parse Python's "settling_time,overshoot" output.
// The worker handles serial communication and recovery to Home.
run = Function({p, i, d}, {o, w},
    o = Run Program(
        Executable(python), // path to the Python interpreter
        Options({q(worker), q(port), Char(p), Char(i), Char(d), q(experimentDir)}),
        Read Function("text")
    );
    w = Words(Trim(o), ",");
    If(N Items(w) != 2,
        Return({., ., "invalid_response"})
    );
    If(w[1] == "ERROR",
        Return(Eval List({., ., w[2]}))
    );
    If(Is Missing(Num(w[1])) | Is Missing(Num(w[2])),
        Return({., ., "non_numeric_response"})
    );
    Eval List({Num(w[1]), Num(w[2]), "measured"});
);

// --- Results table and optimization objectives ---
dt = New Table("Barebones PID BayesOpt",
    New Column("Run", Numeric, Ordinal),
    New Column("Iteration", Numeric, Ordinal),
    New Column("KP", Numeric, Continuous),
    New Column("KI", Numeric, Continuous),
    New Column("KD", Numeric, Continuous),
    New Column("Settling Time s", Numeric, Continuous),
    New Column("Overshoot deg", Numeric, Continuous)
);

failedTrials = New Table("PID Failed Trials",
    New Column("Iteration", Numeric, Ordinal),
    New Column("KP", Numeric, Continuous),
    New Column("KI", Numeric, Continuous),
    New Column("KD", Numeric, Continuous),
    New Column("Status", Character, Nominal)
);
recordFailure = Function({p, kiValue, d, iterationValue, statusValue}, {row},
    failedTrials << Add Rows(1);
    row = N Rows(failedTrials);
    Column(failedTrials, "Iteration")[row] = iterationValue;
    Column(failedTrials, "KP")[row] = p;
    Column(failedTrials, "KI")[row] = kiValue;
    Column(failedTrials, "KD")[row] = d;
    Column(failedTrials, "Status")[row] = statusValue;
    Print("Trial skipped: " || statusValue || ". Continuing experiment.");
    failedTrials << Save(experimentDir || "\failed_trials.jmp");
);
// Failed trials stay out of the optimization table entirely.
recordMeasurement = Function({p, kiValue, d, iterationValue, result}, {row},
    If(result[3] != "measured",
        recordFailure(p, kiValue, d, iterationValue, result[3]);
        Return(0)
    );
    dt << Add Rows(1);
    row = N Rows(dt);
    Column(dt, "Run")[row] = row;
    Column(dt, "Iteration")[row] = iterationValue;
    Column(dt, "KP")[row] = p;
    Column(dt, "KI")[row] = kiValue;
    Column(dt, "KD")[row] = d;
    Column(dt, "Settling Time s")[row] = result[1];
    Column(dt, "Overshoot deg")[row] = result[2];
    dt << Save(experimentDir || "\results.jmp");
    1;
);

// Treat all three gains as continuous factors over the 0-3 range.
For Each({c}, {"KP", "KI", "KD"},
    Column(dt, c) << Set Property("Design Role", DesignRole(Continuous));
    Column(dt, c) << Set Property("Coding", {0, 3});
);

// Desirability settings favor smaller responses, with more weight on settling.
Column(dt, "Settling Time s") << Set Property("Response Limits", {
    Lower(.6, 1),
    Middle(1, .8),
    Upper(180, .001),
    Goal(Minimize),
    Importance(10)
});
Column(dt, "Overshoot deg") << Set Property("Response Limits", {
    Lower(0, 1),
    Middle(30, .2),
    Upper(300, .001),
    Goal(Minimize),
    Importance(6)
});

// --- Seed trials ---
// Measure the initial combinations before requesting new candidates.
// Iteration 0 identifies these seed measurements in the results table.
For(i = 1, i <= N Items(seeds), i++,
    r = run(seeds[i][1], seeds[i][2], seeds[i][3]);
    recordMeasurement(seeds[i][1], seeds[i][2], seeds[i][3], 0, r);
);

// --- Sequential Bayesian optimization ---
// Request and measure one candidate at a time using the accumulated results.
For(iter = 1, iter <= maxRuns - N Items(seeds), iter++,
    // Replenish seed measurements before fitting the optimizer after failures.
    If(N Rows(dt) < N Items(seeds),
        seedIndex = Mod(iter - 1, N Items(seeds)) + 1;
        r = run(seeds[seedIndex][1], seeds[seedIndex][2], seeds[seedIndex][3]);
        recordMeasurement(seeds[seedIndex][1], seeds[seedIndex][2], seeds[seedIndex][3], 0, r);
        Continue();
    );
    Current Data Table(dt);
    before = N Rows(dt);
    bo = dt << Bayesian Optimization(
//        Y(:Name("Settling Time s"), :Name("Overshoot deg")),
		Y( :"Settling Time s"n, :"Overshoot deg"n ),
        X(:KP, :KI, :KD),
        Iteration(:Iteration),
        Run Order(:Run),
	    Continuous Correlation Type( "Matern 5" ),
	    Nominal Correlation Type( "Equal Correlations" ),
	    Ordinal Correlation Type( "Equal Correlations" ),
	    Model Based Augmentation RSquare Threshold( 0.25 ),
        Batch Selection(
            Candidate Runs(
			    Make Table Options(
				    Location( 1 ),
				    Randomize Runs( 1 ),
				    Save desirability function values to columns( 1 ),
				    Save startup script for next batch selection to data table(1),
				    Include reason added column( 1 )
			    )
            )
        )
    );
    Wait(0);
    // Append the candidate and allow JMP time to update the table.
    // Stop if no new row was added.
    bo << Make Table;
    show(iter);
    n = N Rows(dt);
    If(n <= before, Break());

    bo << Close Window();

    // Match the worker's three-decimal gain precision and record tested gains.
    p = Round(Column(dt, "KP")[n] * 1000) / 1000;
    i = Round(Column(dt, "KI")[n] * 1000) / 1000;
    d = Round(Column(dt, "KD")[n] * 1000) / 1000;

    Column(dt, "KP")[n] = p;
    Column(dt, "KI")[n] = i;
    Column(dt, "KD")[n] = d;
    Column(dt, "Run")[n] = n;
    Column(dt, "Iteration")[n] = iter;

    // Store both measured responses for the next optimization iteration.
    r = run(p, i, d);
    If(r[3] != "measured",
        dt << Delete Rows(n);
        recordFailure(p, i, d, iter, r[3]);
        Continue();
    );
    Column(dt, "Settling Time s")[n] = r[1];
    Column(dt, "Overshoot deg")[n] = r[2];
    dt << Save(experimentDir || "\results.jmp");
);

dt << Save(experimentDir || "\results.jmp");
Print("Experiment finished: " || Char(N Rows(dt)) || " measured trials; " ||
    Char(N Rows(failedTrials)) || " failed trials. Logs: " || experimentDir);
