// DiscoveryPID DirectPID 300-degree Bayesian autotune
//
// Session data behavior:
//   Every JSL launch creates a brand-new optimization table with unique
//   timestamped filenames in one flat sessions folder. Previous sessions are
//   never loaded, appended, or overwritten.
//
// Requires JMP 19+ (Bayesian Optimization).

Names Default To Here( 1 );

// ============================================================================
// USER SETTINGS
// ============================================================================

studyName = "PositionStudy_DirectPID_v38_300Deg10xRange";

portName = "COM7";
// USER CONTROLS — 300-degree displacement, wide direct-PID search.
testOffsetDeg = 300.0;
returnMaxPWM = 225.0;
// Displacement controller uses the lowest-Score COMPLETED PID from this
// session. Run 1 has no previous score, so it uses its current candidate PID.
useBestCompletedPIDForSetup = 1;

// HOME TARGET PADDING IN ENCODER PULSES/COUNTS.
// 2 means -2,-1,0,+1,+2 all count as home.
homePaddingPulses = 2;

// MINIMUM NONZERO MOTOR PWM.
// 0 disables it. Raise this until the motor breaks static friction consistently.
minimumDrivePWM = 60.0;

// Maximum physical trials in one study.
maxTotalRuns = 50;

// Invalid physical trials warn, save a finite penalty row, and continue.

requireStartupConfirmation = 1;
supervisedMode = 0;

// Position PID search ranges.
kpLow = 0.5;
kpHigh = 1000.0;

kiLow = 0.0;
kiHigh = 500.0;

kdLow = 0.0;
kdHigh = 200.0;

// ============================================================================
// PATHS - every JSL launch gets its own timestamped session.
// ============================================================================

projectDirectory =
    "C:/Users/mkime/Documents/GITHUB/PID Discovery/DiscoveryPID/";

pythonExecutable =
    "C:/Users/mkime/.platformio/penv/Scripts/python.exe";

workerScript =
    projectDirectory || "tools/run_position_trial.py";

// Use one flat, pre-created sessions directory.
// Every launch still gets unique timestamped filenames, but JMP no longer
// creates a dynamic nested directory before Save Text File().
dataRoot =
    projectDirectory || "data/position_autotune_directpid_v38_300deg10xrange";

sessionRoot =
    dataRoot || "/sessions";

// Safe Windows filename timestamp, for example:
// 08-11-2026_17.12.35
sessionStamp =
    Substitute(
        MDYHMS( Today() ),
        "/",
        "-",
        ":",
        ".",
        " ",
        "_"
    );

// Add a millisecond-ish process/session suffix so even rapid re-runs do not
// overwrite an earlier table started in the same second.
sessionStamp =
    sessionStamp ||
    "_" ||
    Char( Round( Tick Seconds() * 1000 ) );

sessionName =
    studyName || "_" || sessionStamp;

// All files for a launch live directly in sessionRoot.
// sessionName is included in every filename, so launches remain isolated.
sessionDirectory =
    sessionRoot;

compactCSVPath =
    sessionRoot || "/" || sessionName || "_Optimization.csv";

historyCSVPath =
    sessionRoot || "/" || sessionName || "_Response_History.csv";

tableJMPPath =
    sessionRoot || "/" || sessionName || ".jmp";

resultDirectory =
    sessionRoot;

runDirectory =
    sessionRoot;

tempDirectory =
    Get Environment Variable( "TEMP" ) || "/";

// ============================================================================
// SAFE INITIAL DESIGN
// ============================================================================

seedSettings = {
    // Keep a low-gain baseline and the previous upper-bound point,
    // then spread seeds across the enlarged region so the initial
    // design can separate Kp, Ki, and Kd effects.
    {2.0,      0.0,   0.20},
    {100.0,   50.0,  20.00},
    {250.0,  400.0,  80.00},
    {400.0,  150.0, 160.00},
    {550.0,  500.0,  40.00},
    {700.0,  250.0, 200.00},
    {850.0,  100.0, 120.00},
    {1000.0, 450.0, 180.00},
    {1000.0, 500.0, 200.00}
};

maximumBayesianRuns =
    Max(
        0,
        maxTotalRuns - N Items( seedSettings )
    );

// ============================================================================
// HELPERS
// ============================================================================

quoteArgument = Function( {value},
    "\!\"" || Char( value ) || "\!\""
);

asNumber = Function( {value},
    Num( Char( value ) )
);

showFatalError = Function( {messageText},
    New Window(
        "DiscoveryPID DirectPID BestSetup Error",
        <<Modal,
        V List Box(
            Text Box( messageText ),
            Button Box(
                "OK",
                Current Window() << Close Window
            )
        )
    );

    Throw( messageText );
);

validateSetup = Function( {}, {pathProbe},
    // The PowerShell installer creates sessionRoot before JMP starts.
    // Do not create dynamic directories here; that caused the Windows
    // ReadWrite/path-not-found Save Text File failure.
    pathProbe = sessionRoot || "/_jmp_write_test.tmp";
    Save Text File( pathProbe, "ok", Mode( "Replace" ) );
    If( File Exists( pathProbe ), Delete File( pathProbe ) );

If(
        !File Exists( pythonExecutable ),

        showFatalError(
            "Python executable was not found:\!N\!N" ||
            pythonExecutable
        )
    );

    If(
        !File Exists( workerScript ),

        showFatalError(
            "Position V2 Python worker was not found:\!N\!N" ||
            workerScript
        )
    );

    If(
        maxTotalRuns < N Items( seedSettings ),

        showFatalError(
            "maxTotalRuns must be at least " ||
            Char( N Items( seedSettings ) ) ||
            "."
        )
    );
);

confirmStudyStart = Function( {},
    {choice = 0},

    If(
        !requireStartupConfirmation,
        Return( 1 )
    );

    New Window(
        "Arm DiscoveryPID DirectPID BestSetup",
        <<Modal,

        V List Box(
            Text Box(
                "Study: " ||
                studyName ||
                "\!NSession: " || sessionName ||
                "\!N\!N" ||

                "Gearbox-output displacement: " ||
                Char( testOffsetDeg ) ||
                " degrees\!N" ||
                "Displacement setup controller: best completed PID so far\!N" ||
                "Direct PID PWM ceiling: " || Char( returnMaxPWM ) || "\!N" ||
                "Home target padding: +/-" || Char( Round( homePaddingPulses ) ) || " encoder pulses\!N" ||
                "Minimum drive PWM: " || Char( minimumDrivePWM ) || "\!N" ||

                "Maximum total runs: " ||
                Char( maxTotalRuns ) ||
                "\!N\!N" ||

                "Required before arming:\!N" ||
                "  1. Firmware reports EVENT HOMED.\!N" ||
                "  2. Every serial monitor using " ||
                portName ||
                " is closed.\!N" ||
                "  3. The mechanism is clear for the configured displacement/return.\!N\!N" ||

                "A brand-new JMP table is created for this launch. Previous " ||
                "sessions remain saved and are not loaded."
            ),

            H List Box(
                Button Box(
                    "Arm and Start",
                    choice = 1;
                    Current Window() << Close Window;
                ),

                Button Box(
                    "Cancel",
                    choice = 0;
                    Current Window() << Close Window;
                )
            )
        )
    );

    choice;
);

// ============================================================================
// CLEAN NUMERIC STUDY TABLE
// ============================================================================

createCleanWorkingTable = Function( {},
    {dt, kpLimits, kiLimits, kdLimits},

    dt = New Table(
        sessionName || " Position PID Optimization",

        New Column(
            "Run",
            Numeric,
            Ordinal,
            Format( "Best", 12 )
        ),

        New Column(
            "Iteration",
            Numeric,
            Ordinal,
            Format( "Best", 12 )
        ),

        New Column(
            "KP",
            Numeric,
            Continuous,
            Format( "Fixed Dec", 12, 6 )
        ),

        New Column(
            "KI",
            Numeric,
            Continuous,
            Format( "Fixed Dec", 12, 6 )
        ),

        New Column(
            "KD",
            Numeric,
            Continuous,
            Format( "Fixed Dec", 12, 6 )
        ),

        New Column(
            "Setup KP",
            Numeric,
            Continuous,
            Format( "Fixed Dec", 12, 6 )
        ),

        New Column(
            "Setup KI",
            Numeric,
            Continuous,
            Format( "Fixed Dec", 12, 6 )
        ),

        New Column(
            "Setup KD",
            Numeric,
            Continuous,
            Format( "Fixed Dec", 12, 6 )
        ),

        New Column(
            "Setup Source Score",
            Numeric,
            Continuous,
            Format( "Fixed Dec", 12, 6 )
        ),

        New Column(
            "Score",
            Numeric,
            Continuous,
            Format( "Fixed Dec", 12, 6 )
        ),

        New Column(
            "Settling Time (s)",
            Numeric,
            Continuous,
            Format( "Fixed Dec", 12, 5 )
        ),

        New Column(
            "Overshoot (deg)",
            Numeric,
            Continuous,
            Format( "Fixed Dec", 12, 5 )
        ),

        New Column(
            "Oscillations",
            Numeric,
            Ordinal,
            Format( "Best", 12 )
        ),

        New Column(
            "IAE (deg*s)",
            Numeric,
            Continuous,
            Format( "Fixed Dec", 12, 5 )
        ),

        New Column(
            "Peak Output RPM",
            Numeric,
            Continuous,
            Format( "Fixed Dec", 12, 5 )
        ),

        New Column(
            "Final Error (deg)",
            Numeric,
            Continuous,
            Format( "Fixed Dec", 12, 5 )
        ),

        New Column(
            "Success",
            Numeric,
            Nominal,
            Format( "Best", 12 )
        ),

        New Column(
            "Status",
            Character,
            Nominal
        )
    );

    kpLimits = Eval List( {kpLow, kpHigh} );
    kiLimits = Eval List( {kiLow, kiHigh} );
    kdLimits = Eval List( {kdLow, kdHigh} );

    Eval(
        Eval Expr(
            Column( dt, "KP" ) <<
            Set Property( "Coding", Expr( kpLimits ) )
        )
    );

    Eval(
        Eval Expr(
            Column( dt, "KI" ) <<
            Set Property( "Coding", Expr( kiLimits ) )
        )
    );

    Eval(
        Eval Expr(
            Column( dt, "KD" ) <<
            Set Property( "Coding", Expr( kdLimits ) )
        )
    );

    Column( dt, "KP" ) <<
        Set Property( "Design Role", DesignRole( Continuous ) );
    Column( dt, "KP" ) <<
        Set Property( "Factor Changes", Easy );

    Column( dt, "KI" ) <<
        Set Property( "Design Role", DesignRole( Continuous ) );
    Column( dt, "KI" ) <<
        Set Property( "Factor Changes", Easy );

    Column( dt, "KD" ) <<
        Set Property( "Design Role", DesignRole( Continuous ) );
    Column( dt, "KD" ) <<
        Set Property( "Factor Changes", Easy );

    // Safe here because Score was just created explicitly as Numeric.
    Column( dt, "Score" ) <<
        Set Property(
            "Response Limits",
            {
                Goal( Minimize ),
                Importance( 1 ),
                Show Limits( 0 )
            }
        );

    dt;
);

// This session never loads previous optimization rows.
// Each launch starts from zero rows by design.

exportCompactTable = Function( {dt},
    {
        text =
            "Run,Iteration,KP,KI,KD,Setup KP,Setup KI,Setup KD,Setup Source Score," ||
            "Score,Settling Time (s),Overshoot (deg),Oscillations,IAE (deg*s)," ||
            "Peak Output RPM,Final Error (deg),Success,Status\!N",

        rowIndex,
        scoreValue
    },

    For(
        rowIndex = 1,
        rowIndex <= N Rows( dt ),
        rowIndex++,

        scoreValue =
            Column( dt, "Score" )[rowIndex];

        If(
            !Is Missing( scoreValue ),

            text ||=
                Char( Column( dt, "Run" )[rowIndex] ) || "," ||
                Char( Column( dt, "Iteration" )[rowIndex] ) || "," ||
                Char( Column( dt, "KP" )[rowIndex] ) || "," ||
                Char( Column( dt, "KI" )[rowIndex] ) || "," ||
                Char( Column( dt, "KD" )[rowIndex] ) || "," ||
                Char( Column( dt, "Setup KP" )[rowIndex] ) || "," ||
                Char( Column( dt, "Setup KI" )[rowIndex] ) || "," ||
                Char( Column( dt, "Setup KD" )[rowIndex] ) || "," ||
                Char( Column( dt, "Setup Source Score" )[rowIndex] ) || "," ||
                Char( scoreValue ) || "," ||
                Char( Column( dt, "Settling Time (s)" )[rowIndex] ) || "," ||
                Char( Column( dt, "Overshoot (deg)" )[rowIndex] ) || "," ||
                Char( Column( dt, "Oscillations" )[rowIndex] ) || "," ||
                Char( Column( dt, "IAE (deg*s)" )[rowIndex] ) || "," ||
                Char( Column( dt, "Peak Output RPM" )[rowIndex] ) || "," ||
                Char( Column( dt, "Final Error (deg)" )[rowIndex] ) || "," ||
                Char( Column( dt, "Success" )[rowIndex] ) || "," ||
                Char( Column( dt, "Status" )[rowIndex] ) ||
                "\!N";
        );
    );

    Save Text File(
        compactCSVPath,
        text,
        Mode( "Replace" )
    );
);

saveSnapshot = Function( {dt},
    // Save the current session in both portable CSV and native JMP format.
    // This file is overwritten only within THIS session; future JSL launches
    // use a different timestamped filename and never touch this one.
    exportCompactTable( dt );
    dt << Save( tableJMPPath );
);

combinationAlreadyCompleted =
Function( {dt, kpValue, kiValue, kdValue},
    {rowIndex, found = 0},

    For(
        rowIndex = 1,
        rowIndex <= N Rows( dt ),
        rowIndex++,

        If(
            !Is Missing( Column( dt, "Score" )[rowIndex] ) &
            Abs( Column( dt, "KP" )[rowIndex] - kpValue ) < 0.000001 &
            Abs( Column( dt, "KI" )[rowIndex] - kiValue ) < 0.000001 &
            Abs( Column( dt, "KD" )[rowIndex] - kdValue ) < 0.000001,

            found = 1;
            Break();
        );
    );

    found;
);

nextRunNumber = Function( {dt},
    {rowIndex, largestRun = 0, value},

    For(
        rowIndex = 1,
        rowIndex <= N Rows( dt ),
        rowIndex++,

        value = Column( dt, "Run" )[rowIndex];

        If(
            !Is Missing( value ) & value > largestRun,
            largestRun = value;
        );
    );

    largestRun + 1;
);

bestScore = Function( {dt},
    {rowIndex, value, currentBest = .},

    For(
        rowIndex = 1,
        rowIndex <= N Rows( dt ),
        rowIndex++,

        value = Column( dt, "Score" )[rowIndex];

        If(
            !Is Missing( value ) &
            !Is Missing( Column( dt, "Settling Time (s)" )[rowIndex] ) &
            Char( Column( dt, "Status" )[rowIndex] ) == "COMPLETE",

            If(
                Is Missing( currentBest ) | value < currentBest,
                currentBest = value;
            );
        );
    );

    currentBest;
);

// Returns {KP, KI, KD, Score} for the lowest-Score COMPLETED row.
// Returns an empty list when no completed row exists yet.
bestScoringPID =
Function( {dt},
    {
        rowIndex,
        scoreValue,
        bestValue = .,
        bestRow = 0
    },

    For(
        rowIndex = 1,
        rowIndex <= N Rows( dt ),
        rowIndex++,

        scoreValue = Column( dt, "Score" )[rowIndex];

        If(
            !Is Missing( scoreValue ) &
            !Is Missing( Column( dt, "Settling Time (s)" )[rowIndex] ) &
            Char( Column( dt, "Status" )[rowIndex] ) == "COMPLETE",

            If(
                Is Missing( bestValue ) | scoreValue < bestValue,
                bestValue = scoreValue;
                bestRow = rowIndex;
            );
        );
    );

    If(
        bestRow <= 0,
        {},
        Eval List(
            {
                Column( dt, "KP" )[bestRow],
                Column( dt, "KI" )[bestRow],
                Column( dt, "KD" )[bestRow],
                Column( dt, "Score" )[bestRow]
            }
        )
    );
);

resolveSetupPID =
Function( {dt, fallbackKp, fallbackKi, fallbackKd},
    {bestPID},

    bestPID = bestScoringPID( dt );

    If(
        useBestCompletedPIDForSetup &
        N Items( bestPID ) >= 4,

        bestPID,

        // First run fallback: use the current candidate itself.
        Eval List(
            {
                fallbackKp,
                fallbackKi,
                fallbackKd,
                .
            }
        )
    );
);

confirmPhysicalRun =
Function(
    {
        runNumber,
        kpValue,
        kiValue,
        kdValue,
        phaseName
    },

    {choice = 0},

    If(
        !supervisedMode,
        Return( 1 )
    );

    New Window(
        "Position V2 Trial Confirmation",
        <<Modal,

        V List Box(
            Text Box(
                phaseName ||
                " run " ||
                Char( runNumber ) ||
                "\!N\!N" ||

                "KP = " || Char( kpValue ) || "\!N" ||
                "KI = " || Char( kiValue ) || "\!N" ||
                "KD = " || Char( kdValue ) || "\!N"
            ),

            H List Box(
                Button Box(
                    "Run Trial",
                    choice = 1;
                    Current Window() << Close Window;
                ),

                Button Box(
                    "Stop Study",
                    choice = 0;
                    Current Window() << Close Window;
                )
            )
        )
    );

    choice;
);

// ============================================================================
// ONE GUARDED PHYSICAL TRIAL
// ============================================================================

runPhysicalTrial =
Function(
    {
        runNumber,
        kpValue,
        kiValue,
        kdValue,
        setupKpValue,
        setupKiValue,
        setupKdValue,
        setupScoreValue
    },
    {
        resultPath,
        rawPath,
        consoleLogPath,
        pythonOptions,
        outputText,
        displayedOutput,
        resultDT,
        statusText,
        scoreValue,
        resultList
    },

    resultPath =
        resultDirectory ||
        "/" ||
        sessionName ||
        "_Run_" ||
        Char( runNumber ) ||
        "_result.csv";

    rawPath =
        runDirectory ||
        "/" ||
        sessionName ||
        "_Run_" ||
        Char( runNumber ) ||
        "_response.csv";

    consoleLogPath =
        tempDirectory ||
        "DiscoveryPID_" ||
        studyName ||
        "_Run_" ||
        Char( runNumber ) ||
        "_console.txt";

    If( File Exists( resultPath ), Delete File( resultPath ) );
    If( File Exists( consoleLogPath ), Delete File( consoleLogPath ) );

    // Launch Python DIRECTLY. This removes cmd.exe and the temporary .bat file
    // from the physical-control path.
    pythonOptions =
        {
            quoteArgument( workerScript ),

            "--port", quoteArgument( portName ),
            "--trial", Char( runNumber ),

            "--kp", Char( kpValue ),
            "--ki", Char( kiValue ),
            "--kd", Char( kdValue ),

            "--test-offset", Char( testOffsetDeg ),
            "--return-max-pwm", Char( returnMaxPWM ),
            "--home-padding-pulses", Char( Round( homePaddingPulses ) ),
            "--minimum-drive-pwm", Char( minimumDrivePWM ),

            "--setup-kp", Char( setupKpValue ),
            "--setup-ki", Char( setupKiValue ),
            "--setup-kd", Char( setupKdValue ),

            "--result-file", quoteArgument( resultPath ),
            "--raw-file", quoteArgument( rawPath ),
            "--history-file", quoteArgument( historyCSVPath )
        };

    Print(
        "Starting DirectPID physical run " ||
        Char( runNumber ) ||
        ": candidate=(" ||
        Char( kpValue ) || ", " ||
        Char( kiValue ) || ", " ||
        Char( kdValue ) ||
        "), setup=(" ||
        Char( setupKpValue ) || ", " ||
        Char( setupKiValue ) || ", " ||
        Char( setupKdValue ) ||
        ")"
    );

    outputText =
        Run Program(
            Executable( pythonExecutable ),
            Options( pythonOptions ),
            Read Function( "text" )
        );

    displayedOutput =
        If(
            Is Missing( outputText ),
            "(No Python console output returned.)",
            Char( outputText )
        );

    Save Text File(
        consoleLogPath,
        displayedOutput,
        Mode( "Replace" )
    );

    Print( displayedOutput );

    If(
        !File Exists( resultPath ),

        New Window(
            "DiscoveryPID Control Launch Error",
            <<Modal,
            V List Box(
                Text Box(
                    "Python did not create a result file.\!N\!N" ||
                    "Console output:\!N" ||
                    displayedOutput
                ),
                Button Box(
                    "OK",
                    Current Window() << Close Window
                )
            )
        );

        Throw( "Physical worker did not create result file." );
    );

    resultDT = Open( resultPath, Invisible );

    scoreValue =
        asNumber(
            Column( resultDT, "Score" )[1]
        );

    statusText =
        Char(
            Column( resultDT, "Status" )[1]
        );

    If(
        Contains( statusText, "CONTROL_ERROR_" ) == 1,

        displayedOutput =
            displayedOutput ||
            "\!N\!NResult status: " ||
            statusText;

        Close( resultDT, No Save );

        New Window(
            "DiscoveryPID Physical Control Error",
            <<Modal,
            V List Box(
                Text Box(
                    "JMP reached the Python worker, but the worker could not " ||
                    "start the physical trial.\!N\!N" ||
                    displayedOutput
                ),
                Button Box(
                    "OK",
                    Current Window() << Close Window
                )
            )
        );

        Throw( statusText );
    );

    If(
        Is Missing( scoreValue ),
        scoreValue = 9999.0;
    );

    resultList = Eval List(
        {
            scoreValue,
            asNumber( Column( resultDT, "Settling Time (s)" )[1] ),
            asNumber( Column( resultDT, "Return Timer Started" )[1] ),
            asNumber( Column( resultDT, "Overshoot (deg)" )[1] ),
            asNumber( Column( resultDT, "Oscillations" )[1] ),
            asNumber( Column( resultDT, "IAE (deg*s)" )[1] ),
            asNumber( Column( resultDT, "Peak Output RPM" )[1] ),
            asNumber( Column( resultDT, "Final Error (deg)" )[1] ),
            asNumber( Column( resultDT, "Success" )[1] ),
            statusText,
            asNumber( Column( resultDT, "Samples" )[1] )
        }
    );

    Close( resultDT, No Save );

    // ---------------------------------------------------------------
    // RELEASE-TO-HOME MEASUREMENT WARNING
    //
    // Settling Time is ONLY:
    // EVENT TEST_RETURN -> first abs(ErrCounts) <= homePaddingPulses.
    //
    // Invalid trials are SAVED with their finite penalty score and the study
    // CONTINUES. They are never eligible to become the best setup PID.
    // ---------------------------------------------------------------
    If(
        resultList[3] != 1 |
        Is Missing( resultList[2] ) |
        resultList[11] <= 0 |
        resultList[10] != "COMPLETE",

        New Window(
            "DiscoveryPID Trial Warning",
            V List Box(
                Text Box(
                    If(
                        resultList[10] == "TEST_PREP_TIMEOUT",

                        "WARNING: RETURN TIMER NEVER STARTED.\!N\!N" ||
                        "The mechanism did not finish the 300-degree displacement/prep phase.\!N" ||
                        "Displacement time is NOT part of Settling Time.\!N" ||
                        "This run will be saved as an invalid penalty row and JMP will continue.",

                        resultList[3] != 1,

                        "WARNING: EVENT TEST_RETURN was not observed.\!N\!N" ||
                        "No release-to-home Settling Time exists for this run.\!N" ||
                        "The penalty row will be saved and JMP will continue.",

                        Is Missing( resultList[2] ),

                        "WARNING: RETURN STARTED BUT HOME WINDOW WAS NOT REACHED.\!N\!N" ||
                        "The encoder never entered +/-" ||
                        Char( Round( homePaddingPulses ) ) ||
                        " pulses of home.\!N" ||
                        "The penalty row will be saved and JMP will continue.",

                        "WARNING: invalid physical measurement.\!N\!N" ||
                        "Status: " || resultList[10] ||
                        "\!NSettling Time: " ||
                        If( Is Missing( resultList[2] ), "MISSING", Char( resultList[2] ) ) ||
                        "\!NReturn samples: " || Char( resultList[11] ) ||
                        "\!N\!NThe penalty row will be saved and JMP will continue."
                    )
                ),

                Button Box(
                    "Dismiss",
                    Current Window() << Close Window
                )
            )
        );

        Print(
            "TRIAL WARNING Run=" || Char( runNumber ) ||
            " Status=" || resultList[10] ||
            " Settling=" ||
            If( Is Missing( resultList[2] ), "MISSING", Char( resultList[2] ) ) ||
            " -- continuing study."
        );
    );

    resultList;
);

saveCompletedRun =
Function(
    {
        dt,
        rowIndex,
        runNumber,
        iterationNumber,
        resultList,
        setupKpValue,
        setupKiValue,
        setupKdValue,
        setupScoreValue
    },

    Column( dt, "Run" )[rowIndex] = runNumber;
    Column( dt, "Iteration" )[rowIndex] = iterationNumber;

    Column( dt, "Setup KP" )[rowIndex] = setupKpValue;
    Column( dt, "Setup KI" )[rowIndex] = setupKiValue;
    Column( dt, "Setup KD" )[rowIndex] = setupKdValue;
    Column( dt, "Setup Source Score" )[rowIndex] = setupScoreValue;

    Column( dt, "Score" )[rowIndex] = resultList[1];
    Column( dt, "Settling Time (s)" )[rowIndex] = resultList[2];
    Column( dt, "Overshoot (deg)" )[rowIndex] = resultList[4];
    Column( dt, "Oscillations" )[rowIndex] = resultList[5];
    Column( dt, "IAE (deg*s)" )[rowIndex] = resultList[6];
    Column( dt, "Peak Output RPM" )[rowIndex] = resultList[7];
    Column( dt, "Final Error (deg)" )[rowIndex] = resultList[8];
    Column( dt, "Success" )[rowIndex] = resultList[9];
    Column( dt, "Status" )[rowIndex] = resultList[10];

    saveSnapshot( dt );
);

// ============================================================================
// START
// ============================================================================

validateSetup();

If(
    !confirmStudyStart(),
    Throw( "Position V2 study cancelled." )
);

// EVERY execution creates a new zero-row table.
// Previous .jmp/CSV sessions are saved in their own timestamped folders and
// are never loaded into this run.
dt = createCleanWorkingTable();

Current Data Table( dt );
saveSnapshot( dt );

Print(
    "DiscoveryPID DirectPID BestSetup started NEW session: " ||
    sessionName
);

Print(
    "Session table: " ||
    tableJMPPath
);

stopRequested = 0;
stopReason = "";

// ============================================================================
// SEEDS
// ============================================================================

If(
    !stopRequested,

    For(
        seedIndex = 1,
        seedIndex <= N Items( seedSettings ),
        seedIndex++,

        seedKp = seedSettings[seedIndex][1];
        seedKi = seedSettings[seedIndex][2];
        seedKd = seedSettings[seedIndex][3];

        If(
            N Rows( dt ) >= maxTotalRuns,
            stopRequested = 1;
            stopReason = "Maximum V2 run count reached.";
            Break();
        );

        If(
            !combinationAlreadyCompleted(
                dt,
                seedKp,
                seedKi,
                seedKd
            ),

            runNumber = nextRunNumber( dt );

            If(
                !confirmPhysicalRun(
                    runNumber,
                    seedKp,
                    seedKi,
                    seedKd,
                    "Seed"
                ),

                stopRequested = 1;
                stopReason = "Study stopped by operator.";
                Break();
            );

            setupPID =
                resolveSetupPID(
                    dt,
                    seedKp,
                    seedKi,
                    seedKd
                );

            setupKpValue = setupPID[1];
            setupKiValue = setupPID[2];
            setupKdValue = setupPID[3];
            setupScoreValue = setupPID[4];

            resultList =
                runPhysicalTrial(
                    runNumber,
                    seedKp,
                    seedKi,
                    seedKd,
                    setupKpValue,
                    setupKiValue,
                    setupKdValue,
                    setupScoreValue
                );

            If(
                N Items( resultList ) == 0,

                stopRequested = 1;
                stopReason =
                    "Physical trial stopped. Existing completed runs were saved.";
                Break();
            );

            dt << Add Rows( 1 );
            newRow = N Rows( dt );

            Column( dt, "KP" )[newRow] = seedKp;
            Column( dt, "KI" )[newRow] = seedKi;
            Column( dt, "KD" )[newRow] = seedKd;

            saveCompletedRun(
                dt,
                newRow,
                runNumber,
                0,
                resultList,
                setupKpValue,
                setupKiValue,
                setupKdValue,
                setupScoreValue
            );

        );
    );
);

// ============================================================================
// BAYESIAN OPTIMIZATION
// ============================================================================

If(
    !stopRequested,

    For(
        bayesIteration = 1,
        bayesIteration <= maximumBayesianRuns,
        bayesIteration++,

        If(
            N Rows( dt ) >= maxTotalRuns,
            stopRequested = 1;
            stopReason = "Maximum V2 run count reached.";
            Break();
        );

        runNumber = nextRunNumber( dt );
        rowsBefore = N Rows( dt );

        bo =
            dt << Bayesian Optimization(
                Y( :Score ),

                X(
                    :KP,
                    :KI,
                    :KD
                ),

                Iteration( :Iteration ),
                Run Order( :Run ),

                Generate Candidate Set(
                    Candidate Set Size( 4000 ),
                    Include Runs that Do Not Conform to Constraints( 0 )
                ),

                Autoselect Batch(
                    Batch Size( 1 ),
                    Minimum RSquare( 0.50 )
                ),

                Make Table Options(
                    Location( 1 ),
                    Randomize Runs( 0 ),
                    Save desirability function values to columns( 0 ),
                    Save startup script for next batch selection to data table( 0 ),
                    Include observed desirabilities( 0 ),
                    Include original candidate set row indices( 0 ),
                    Include reason added column( 0 ),
                    Include predicted response values( 0 ),
                    Include prediction standard deviations( 0 ),
                    Include Bayesian desirability expected improvement column( 0 )
                )
            );

        // Official JMP message. Do not call Report(bo); that caused the
        // previous "Expected platform argument" error on this JMP install.
        bo << Make Table;
        Wait( 0.2 );

        If(
            N Rows( dt ) <= rowsBefore,

            stopRequested = 1;
            stopReason =
                "JMP Bayesian Optimization did not append a candidate row.";
            Break();
        );

        newRow = N Rows( dt );

        proposedKp = Column( dt, "KP" )[newRow];
        proposedKi = Column( dt, "KI" )[newRow];
        proposedKd = Column( dt, "KD" )[newRow];

        // Warn if JMP proposes outside the configured experimental region,
        // but keep the study alive as requested.
        If(
            proposedKp < kpLow | proposedKp > kpHigh |
            proposedKi < kiLow | proposedKi > kiHigh |
            proposedKd < kdLow | proposedKd > kdHigh,

            New Window(
                "DiscoveryPID Bayesian Range Warning",
                V List Box(
                    Text Box(
                        "WARNING: JMP proposed a PID outside the configured range.\!N\!N" ||
                        "KP = " || Char( proposedKp ) || "\!N" ||
                        "KI = " || Char( proposedKi ) || "\!N" ||
                        "KD = " || Char( proposedKd ) || "\!N\!N" ||
                        "Configured maxima: KP=" || Char( kpHigh ) ||
                        ", KI=" || Char( kiHigh ) ||
                        ", KD=" || Char( kdHigh ) ||
                        "\!N\!NThe study will continue."
                    ),
                    Button Box(
                        "Dismiss",
                        Current Window() << Close Window
                    )
                )
            );

            Print(
                "BAYESIAN RANGE WARNING: KP=" || Char( proposedKp ) ||
                " KI=" || Char( proposedKi ) ||
                " KD=" || Char( proposedKd ) ||
                " -- continuing."
            );
        );

        If(
            !confirmPhysicalRun(
                runNumber,
                proposedKp,
                proposedKi,
                proposedKd,
                "Bayesian"
            ),

            dt << Delete Rows( newRow );
            saveSnapshot( dt );

            stopRequested = 1;
            stopReason = "Study stopped by operator.";
            Break();
        );

        setupPID =
            resolveSetupPID(
                dt,
                proposedKp,
                proposedKi,
                proposedKd
            );

        setupKpValue = setupPID[1];
        setupKiValue = setupPID[2];
        setupKdValue = setupPID[3];
        setupScoreValue = setupPID[4];

        resultList =
            runPhysicalTrial(
                runNumber,
                proposedKp,
                proposedKi,
                proposedKd,
                setupKpValue,
                setupKiValue,
                setupKdValue,
                setupScoreValue
            );

        saveCompletedRun(
            dt,
            newRow,
            runNumber,
            bayesIteration,
            resultList,
            setupKpValue,
            setupKiValue,
            setupKdValue,
            setupScoreValue
        );

    );
);

If(
    stopReason == "",

    If(
        N Rows( dt ) >= maxTotalRuns,
        stopReason = "Maximum V2 run count reached.",
        stopReason = "Configured Bayesian run limit reached."
    );
);

// ============================================================================
// FINAL SAVE + SIMPLE SUMMARY
// No Loc(), no Report(bo), and no reopening old .jmp tables.
// ============================================================================

saveSnapshot( dt );
dt << Bring Window To Front;

currentBest = bestScore( dt );

New Window(
    "DiscoveryPID DirectPID BestSetup Complete",
    <<Modal,

    V List Box(
        Text Box(
            "Study: " || studyName || "\!N\!N" ||

            "Stop reason:\!N" ||
            stopReason ||
            "\!N\!N" ||

            "Completed V2 runs: " ||
            Char( N Rows( dt ) ) ||
            " of " ||
            Char( maxTotalRuns ) ||
            "\!N" ||

            "Best score: " ||
            If(
                Is Missing( currentBest ),
                "N/A",
                Char( currentBest )
            ) ||
            "\!N\!N" ||

            "Saved JMP table:\!N" ||
            tableJMPPath ||
            "\!N\!N" ||

            "Session CSV:\!N" ||
            compactCSVPath ||
            "\!N\!N" ||

            "This session is permanently preserved. The next JSL launch creates " ||
            "a completely new timestamped set of session files."
        ),

        Button Box(
            "OK",
            Current Window() << Close Window
        )
    )
);
